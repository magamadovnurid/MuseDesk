{
  "name": "muse-desk-desktop",
  "productName": "Muse Desk",
  "version": "1.25.0",
  "description": "Локальный помощник для macOS и Ubuntu: проекты, чаты и Muse Glimmer",
  "author": "Muse Desk",
  "license": "UNLICENSED",
  "main": "main.cjs",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "electron . --smoke-test",
    "build": "electron-builder --mac dmg zip --arm64 --publish never",
    "build:linux": "electron-builder --linux deb --x64 --publish never --config.directories.output=../dist-linux"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.musedesk.desktop",
    "directories": {
      "output": "../dist-macos"
    },
    "files": [
      "*.cjs",
      "*.html",
      "*.css",
      "*.js",
      "catalog.json",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "minimumSystemVersion": "14.0",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "entitlementsInherit": "entitlements.plist",
      "icon": "assets/icon.png"
    },
    "artifactName": "MuseDesk-${version}-macOS-AppleSilicon.${ext}",
    "dmg": {
      "title": "Muse Desk",
      "window": {
        "width": 640,
        "height": 420
      },
      "contents": [
        {
          "x": 180,
          "y": 180
        },
        {
          "x": 460,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Office",
      "icon": "assets/icon.png",
      "executableName": "muse-desk",
      "artifactName": "MuseDesk-${version}-Ubuntu-amd64.${ext}",
      "maintainer": "Muse Desk <musedesk@users.noreply.github.com>"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2 | libasound2t64",
        "curl",
        "ca-certificates",
        "zstd",
        "espeak-ng"
      ]
    }
  },
  "homepage": "https://github.com/magamadovnurid/MuseDesk"
}
